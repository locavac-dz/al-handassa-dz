# ─── SERVER ───────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── PostgreSQL ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=handassi_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── JWT ───────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# ─── EMAIL (SMTP) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@handassi.dz
SMTP_PASS=your_email_app_password
EMAIL_FROM="Handassi.dz <contact@handassi.dz>"

# ─── UPLOAD ────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,mp4,zip,epub

# ─── PAYMENT — SATIM (CIB/Dahabiya Algérie) ───────────
SATIM_API_URL=https://satim.dz/payment/rest
SATIM_MERCHANT_ID=your_merchant_id
SATIM_TERMINAL_ID=your_terminal_id
SATIM_USERNAME=your_satim_username
SATIM_PASSWORD=your_satim_password
SATIM_SUCCESS_URL=http://localhost:3000/payment/success
SATIM_FAIL_URL=http://localhost:3000/payment/fail

# ─── PAYMENT — BaridiMob ──────────────────────────────
BARIDIMOB_API_URL=https://api.baridimob.dz
BARIDIMOB_MERCHANT_ID=your_baridimob_merchant_id
BARIDIMOB_API_KEY=your_baridimob_api_key

# ─── LICENCES LOGICIELLES (BétonLab DG, etc.) ─────────
# Secret HMAC serveur : distinct du secret client-side embarqué dans chaque
# application — ne le partager avec aucun fichier livré à un client.
LICENSE_HMAC_SECRET=change_this_to_a_long_random_value

# ─── FRONTEND URL ──────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── RATE LIMITING ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Nombre de reverse proxys de confiance devant l'app (Railway, Vercel, nginx = 1). Sert à lire la vraie IP client
# pour le rate limiting. Défaut : 1 en production, 0 sinon. Ne jamais mettre "true".
TRUST_PROXY=1
# URL publique de l'API pour les liens des emails (confirmation/désinscription newsletter). Défaut : FRONTEND_URL.
API_URL=http://localhost:5000
# Domaine public du site, utilisé dans sitemap.xml (défaut : https://handassi.dz).
SITE_URL=https://handassi.dz
# Base de données : DATABASE_URL (Railway/Heroku) prend le pas sur DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base
# SSL en production : par défaut chiffré sans vérification du certificat ; DB_SSL=strict (+ DB_SSL_CA) pour vérifier ;
# DB_SSL=false pour une base sur réseau privé sans SSL.
# DB_SSL=strict
# Attente maximale d'une connexion à la base, en ms (défaut 10000). /health : délai avant de déclarer la base en panne (défaut 3000).
# DB_CONNECT_TIMEOUT_MS=10000
# HEALTH_DB_TIMEOUT_MS=3000
# Serveur SMTP de développement à certificat auto-signé uniquement : désactive la vérification du certificat. Jamais en production.
# SMTP_TLS_INSECURE=true
# Aperçus PDF : nombre de pages publiées pour un produit PAYANT (défaut 5 ; 0 = aperçu complet). Un produit gratuit garde un aperçu complet.
# PREVIEW_MAX_PAGES=5
# Interpréteur Python (avec PyMuPDF installé : pip install pymupdf) utilisé pour générer les aperçus.
# PREVIEW_PYTHON=python3
# ─── SAUVEGARDES (node backup.js run|verify — voir deploy/README.md) ───
# Dossier des sauvegardes : chemin absolu, HORS de uploads/ (dossier servi au public).
# BACKUP_DIR=/var/backups/handassi
# Durées de conservation : dumps en jours, copies mensuelles, instantanés d'uploads (défauts 14 / 12 / 7).
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_MONTHLY=12
# BACKUP_KEEP_SNAPSHOTS=7
# BACKUP_UPLOADS=false        # base seule (uploads ailleurs, ou sauvegarde fréquente)
# PG_BIN=C:/Program Files/PostgreSQL/17/bin   # dossier de pg_dump/pg_restore s'ils ne sont pas dans le PATH
# Alertes healthchecks.io (ping après succès, <url>/fail sinon) : détectent une sauvegarde qui ne tourne plus.
# HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx
# HEALTHCHECK_URL_VERIFY=https://hc-ping.com/yyyyyyyy
